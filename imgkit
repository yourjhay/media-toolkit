#!/usr/bin/env bash
# Launcher for the image toolkit TUI.
set -euo pipefail

# Follow the symlink chain: this script is commonly symlinked onto PATH, and
# the venv lives next to the real file, not next to the link.
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  LINK_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$LINK_DIR/$SOURCE"
done
HERE="$(cd -P "$(dirname "$SOURCE")" && pwd)"

if [ ! -x "$HERE/.venv/bin/python" ]; then
  echo "Virtualenv missing. Run: $HERE/setup.sh" >&2
  exit 1
fi

# Tell Python where the package lives. Without this it is only importable when
# the current directory happens to be the project, because that is what puts it
# on sys.path. Deliberately not a `cd`: the prompts accept relative paths, which
# must resolve where the user is standing, not where the toolkit is installed.
export PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}"

exec "$HERE/.venv/bin/python" -m image_toolkit "$@"
